<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <queries>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE"/></intent>
    <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
  </queries>
  <application android:label="Raccoon Tier" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/Rt" android:hardwareAccelerated="true" android:allowBackup="false">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
        android:windowSoftInputMode="adjustNothing">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
